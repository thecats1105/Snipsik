{
  "name": "snipsik",
  "version": "1.0.0",
  "description": "Discord URL Shortener Bot powered by Bun, TypeScript, and Sink",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
